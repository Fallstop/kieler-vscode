{
  "name": "sccharts-lab",
  "displayName": "SCCharts Lab",
  "description": "Edit, visualise, simulate tick by tick, and debug SCCharts models in VS Code. Independent fork of the KIELER VS Code extension (keith-vscode).",
  "version": "0.7.1",
  "publisher": "qinnovate",
  "author": "Jasper Miller-Waugh",
  "contributors": [
    "KIELER <kieler@rtsys.informatik.uni-kiel.de>"
  ],
  "icon": "icon.png",
  "license": "EPL-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Fallstop/kieler-vscode"
  },
  "bugs": {
    "url": "https://github.com/Fallstop/kieler-vscode/issues"
  },
  "homepage": "https://github.com/Fallstop/kieler-vscode#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "sccharts",
    "kieler",
    "statecharts",
    "synchronous",
    "simulation"
  ],
  "activationEvents": [
    "onLanguage:sctx",
    "onLanguage:scl",
    "onLanguage:elkt",
    "onLanguage:elkj",
    "onLanguage:kgt",
    "onLanguage:kgx",
    "onLanguage:kviz",
    "onLanguage:strl",
    "onLanguage:lus"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "kgt",
        "aliases": [
          "KGraph",
          "kgt"
        ],
        "extensions": [
          "kgt"
        ],
        "configuration": "./configurations/language-configuration.json"
      },
      {
        "id": "kgx",
        "aliases": [
          "KGraph",
          "kgx"
        ],
        "extensions": [
          "kgx"
        ],
        "configuration": "./configurations/language-configuration.json"
      },
      {
        "id": "elkt",
        "aliases": [
          "Elk Graph",
          "elkt"
        ],
        "extensions": [
          "elkt"
        ],
        "configuration": "./configurations/language-configuration.json"
      },
      {
        "id": "elkj",
        "aliases": [
          "Elk Graph",
          "elkj"
        ],
        "extensions": [
          "elkj"
        ]
      },
      {
        "id": "strl",
        "aliases": [
          "Esterel",
          "strl"
        ],
        "extensions": [
          "strl"
        ],
        "configuration": "./configurations/strl-language-configuration.json"
      },
      {
        "id": "kviz",
        "aliases": [
          "KiVis",
          "kviz"
        ],
        "extensions": [
          "kviz"
        ],
        "configuration": "./configurations/language-configuration.json"
      },
      {
        "id": "lus",
        "aliases": [
          "Lustre",
          "lus"
        ],
        "extensions": [
          "lus"
        ],
        "configuration": "./configurations/language-configuration.json"
      },
      {
        "id": "sctx",
        "aliases": [
          "SCTX",
          "sctx"
        ],
        "extensions": [
          "sctx"
        ],
        "configuration": "./configurations/language-configuration.json"
      },
      {
        "id": "scl",
        "aliases": [
          "SCL",
          "scl"
        ],
        "extensions": [
          "scl"
        ],
        "configuration": "./configurations/language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "kgt",
        "scopeName": "text.kgt",
        "path": "./syntaxes/kgt.tmLanguage.json"
      },
      {
        "language": "elkt",
        "scopeName": "text.elkt",
        "path": "./syntaxes/elkt.tmLanguage.json"
      },
      {
        "language": "strl",
        "scopeName": "text.strl",
        "path": "./syntaxes/strl.tmLanguage.json"
      },
      {
        "language": "kviz",
        "scopeName": "text.kviz",
        "path": "./syntaxes/kviz.tmLanguage.json"
      },
      {
        "language": "lus",
        "scopeName": "text.lus",
        "path": "./syntaxes/lus.tmLanguage.json"
      },
      {
        "language": "sctx",
        "scopeName": "text.sctx",
        "path": "./syntaxes/sctx.tmLanguage.json"
      },
      {
        "language": "scl",
        "scopeName": "text.scl",
        "path": "./syntaxes/scl.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "keith-vscode.compile",
        "title": "Compile current model with...",
        "icon": "$(server-process)",
        "category": "KiCo"
      },
      {
        "command": "keith-vscode.compile-snapshot",
        "title": "Compile diagram model with...",
        "icon": "$(server-process)",
        "category": "KiCo"
      },
      {
        "command": "keith-vscode.show-stage",
        "title": "Show Compilation Stage...",
        "icon": "$(list-tree)"
      },
      {
        "command": "keith-vscode.show-model",
        "title": "Show Model in Diagram",
        "icon": "$(arrow-left)"
      },
      {
        "command": "keith-vscode.auto-compile",
        "title": "Set auto-compile to ...",
        "category": "KiCo"
      },
      {
        "command": "keith-vscode.show-resulting-model",
        "title": "Show model after compile?",
        "category": "KiCo"
      },
      {
        "command": "keith-vscode.show-private-systems",
        "title": "Show private systems?",
        "category": "KiCo"
      },
      {
        "command": "keith-vscode.inplace",
        "title": "Set inplace compilation to ...",
        "category": "KiCo"
      },
      {
        "command": "keith-vscode.show-next",
        "title": "Show next",
        "category": "KiCo"
      },
      {
        "command": "keith-vscode.show-previous",
        "title": "Show previous",
        "category": "KiCo"
      },
      {
        "command": "keith-vscode.request-compilation-systems",
        "title": "Request compilation systems",
        "category": "KiCo"
      },
      {
        "command": "keith-vscode.compilation-time",
        "title": "Show compilation duration ...",
        "category": "KiCo"
      },
      {
        "command": "keith-vscode.simulate",
        "title": "Simulate current model with...",
        "icon": "$(play)",
        "category": "Simulation"
      },
      {
        "command": "keith-vscode.simulate-snapshot",
        "title": "Simulate current diagram model with...",
        "icon": "$(play)",
        "category": "Simulation"
      },
      {
        "command": "keith-vscode.open-kviz-external",
        "title": "Open KIELER visualization in browser",
        "category": "Simulation",
        "icon": "$(preview)"
      },
      {
        "command": "keith-vscode.simulation-stop",
        "title": "Stop simulation",
        "category": "Simulation",
        "icon": "$(debug-stop)"
      },
      {
        "command": "keith-vscode.simulation-step",
        "title": "Execute simulation step",
        "category": "Simulation",
        "icon": "$(debug-step-over)"
      },
      {
        "command": "keith-vscode.simulation-run",
        "title": "Run simulation",
        "category": "Simulation",
        "icon": "$(debug-continue)"
      },
      {
        "command": "keith-vscode.simulation-pause",
        "title": "Pause simulation",
        "category": "Simulation",
        "icon": "$(debug-pause)"
      },
      {
        "command": "keith-vscode.simulation-restart",
        "title": "Restart simulation",
        "category": "Simulation",
        "icon": "$(debug-restart)"
      },
      {
        "command": "keith-vscode.simulation-rebuild",
        "title": "Rebuild and Restart Simulation",
        "icon": "$(sync)"
      },
      {
        "command": "keith-vscode.simulation-save-trace",
        "title": "Save trace",
        "category": "Simulation"
      },
      {
        "command": "keith-vscode.simulation-load-trace",
        "title": "Load trace",
        "category": "Simulation"
      },
      {
        "command": "keith-vscode.simulation-step-delay",
        "title": "Set simulation step delay to ...",
        "category": "Simulation"
      },
      {
        "command": "keith-vscode.simulation-type",
        "title": "Set simulation type to ...",
        "category": "Simulation"
      },
      {
        "command": "keith-vscode.show-internal-variables",
        "title": "Set display internal variables to ...",
        "category": "Simulation"
      },
      {
        "command": "keith-vscode.restart-language-server",
        "title": "Restart KIELER language server",
        "icon": "$(debug-restart)",
        "category": "KIELER"
      },
      {
        "command": "keith-vscode.diagram.restart",
        "title": "Restart diagram",
        "icon": "$(debug-restart)",
        "category": "KIELER Diagram"
      },
      {
        "command": "keith-vscode.diagram.center",
        "title": "Center diagram selection",
        "icon": "$(location)",
        "category": "KIELER Diagram"
      },
      {
        "command": "keith-vscode.diagram.fit",
        "title": "Fit diagram to viewport",
        "icon": "$(move)",
        "category": "KIELER Diagram"
      },
      {
        "command": "keith-vscode.diagram.layout",
        "title": "Layout the diagram to fit the new viewport",
        "icon": "$(editor-layout)",
        "category": "KIELER Diagram"
      },
      {
        "command": "keith-vscode.diagram.refresh",
        "title": "Refresh the diagram",
        "icon": "$(refresh)",
        "category": "KIELER Diagram"
      },
      {
        "command": "keith-vscode.diagram.export",
        "title": "Export diagram to SVG",
        "icon": "$(clone)",
        "category": "KIELER Diagram"
      },
      {
        "command": "keith-vscode.diagram.sync",
        "title": "Enable Sync With Editor",
        "enablement": "!keith-vscode.syncWithEditor",
        "category": "KIELER Diagram"
      },
      {
        "command": "keith-vscode.diagram.noSync",
        "title": "Disable Sync With Editor",
        "enablement": "keith-vscode.syncWithEditor",
        "category": "KIELER Diagram"
      },
      {
        "command": "keith-vscode.diagram.data.clear",
        "title": "Clear Persisted Diagram Data",
        "icon": "$(clear-all)",
        "category": "KIELER Diagram"
      },
      {
        "command": "keith-vscode.diagram.debugOptions",
        "title": "Activate Diagram Debug Options",
        "category": "KIELER Diagram"
      },
      {
        "command": "keith-vscode.diagram.open",
        "title": "Open Diagram Preview",
        "icon": "$(open-preview)",
        "category": "KIELER Diagram"
      },
      {
        "command": "keith-vscode.generate-code",
        "title": "Generate Code...",
        "category": "SCCharts",
        "icon": "$(code)"
      },
      {
        "command": "keith-vscode.save-generated-code",
        "title": "Save Generated File As...",
        "category": "SCCharts",
        "icon": "$(save)"
      },
      {
        "command": "keith-vscode.save-all-generated-code",
        "title": "Save All Generated Files...",
        "category": "SCCharts",
        "icon": "$(save-all)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "when": "keith.vscode:compilationReady && resourceLangId in keith-vscode.languages",
          "command": "keith-vscode.compile"
        },
        {
          "when": "keith.vscode:compilationReady && resourceLangId in keith-vscode.languages",
          "command": "keith-vscode.compile-snapshot"
        },
        {
          "when": "keith.vscode:compilationReady && resourceLangId in keith-vscode.languages",
          "command": "keith-vscode.show-stage"
        },
        {
          "when": "keith-vscode.diagramOpen",
          "command": "keith-vscode.show-model"
        },
        {
          "command": "keith-vscode.auto-compile"
        },
        {
          "command": "keith-vscode.show-resulting-model"
        },
        {
          "command": "keith-vscode.show-private-systems"
        },
        {
          "command": "keith-vscode.inplace"
        },
        {
          "command": "keith-vscode.show-next"
        },
        {
          "command": "keith-vscode.show-previous"
        },
        {
          "command": "keith-vscode.request-compilation-systems"
        },
        {
          "command": "keith-vscode.compilation-time"
        },
        {
          "when": "keith.vscode:compilationReady && resourceLangId in keith-vscode.languages",
          "command": "keith-vscode.simulate"
        },
        {
          "when": "keith.vscode:compilationReady && resourceLangId in keith-vscode.languages",
          "command": "keith-vscode.simulate-snapshot"
        },
        {
          "command": "keith-vscode.simulation-stop",
          "when": "keith.vscode:simulationRunning"
        },
        {
          "command": "keith-vscode.simulation-step",
          "when": "keith.vscode:simulationRunning"
        },
        {
          "command": "keith-vscode.simulation-run",
          "when": "keith.vscode:simulationRunning"
        },
        {
          "command": "keith-vscode.simulation-pause",
          "when": "keith.vscode:simulationRunning"
        },
        {
          "command": "keith-vscode.simulation-restart",
          "when": "!keith.vscode:simulationRunning"
        },
        {
          "command": "keith-vscode.simulation-rebuild",
          "when": "keith.vscode:simulationRunning"
        },
        {
          "command": "keith-vscode.simulation-save-trace",
          "when": "keith.vscode:simulationRunning"
        },
        {
          "command": "keith-vscode.simulation-load-trace",
          "when": "keith.vscode:simulationRunning"
        },
        {
          "command": "keith-vscode.open-kviz-external",
          "when": "keith.vscode:simulationRunning"
        },
        {
          "command": "keith-vscode.restart-language-server"
        },
        {
          "command": "keith-vscode.diagram.data.clear"
        },
        {
          "command": "keith-vscode.diagram.debugOptions"
        },
        {
          "command": "keith-vscode.diagram.restart"
        },
        {
          "when": "keith-diagram-focused",
          "command": "keith-vscode.diagram.center"
        },
        {
          "when": "keith-diagram-focused",
          "command": "keith-vscode.diagram.fit"
        },
        {
          "when": "keith-diagram-focused",
          "command": "keith-vscode.diagram.layout"
        },
        {
          "when": "keith-diagram-focused",
          "command": "keith-vscode.diagram.refresh"
        },
        {
          "when": "keith-diagram-focused",
          "command": "keith-vscode.diagram.export"
        },
        {
          "when": "keith-diagram-focused",
          "command": "keith-vscode.diagram.sync"
        },
        {
          "when": "keith-diagram-focused",
          "command": "keith-vscode.diagram.noSync"
        },
        {
          "command": "keith-vscode.generate-code",
          "when": "resourceLangId == sctx && resourceScheme == file"
        },
        {
          "command": "keith-vscode.save-generated-code",
          "when": "resourceScheme == sccharts-generated"
        },
        {
          "command": "keith-vscode.save-all-generated-code",
          "when": "resourceScheme == sccharts-generated"
        }
      ],
      "editor/title": [
        {
          "when": "keith.vscode:compilationReady && resourceLangId in keith-vscode.languages",
          "command": "keith-vscode.compile",
          "group": "navigation@1"
        },
        {
          "when": "keith.vscode:compilationReady && resourceLangId in keith-vscode.languages",
          "command": "keith-vscode.simulate",
          "group": "navigation@2"
        },
        {
          "when": "resourceLangId in keith-vscode.languages",
          "command": "keith-vscode.diagram.open",
          "group": "navigation@1"
        },
        {
          "when": "keith.vscode:compilationReady && resourceLangId in keith-vscode.languages",
          "command": "keith-vscode.show-stage",
          "group": "2_codegen@2"
        },
        {
          "command": "keith-vscode.simulation-step",
          "when": "keith.vscode:simulationRunning && (keith-diagram-focused || resourceLangId == sctx)",
          "group": "navigation@11"
        },
        {
          "command": "keith-vscode.simulation-run",
          "when": "keith.vscode:simulationRunning && (keith-diagram-focused || resourceLangId == sctx) && !keith.vscode:play",
          "group": "navigation@12"
        },
        {
          "command": "keith-vscode.simulation-pause",
          "when": "keith.vscode:simulationRunning && (keith-diagram-focused || resourceLangId == sctx) && keith.vscode:play",
          "group": "navigation@12"
        },
        {
          "command": "keith-vscode.simulation-stop",
          "when": "keith.vscode:simulationRunning && (keith-diagram-focused || resourceLangId == sctx)",
          "group": "navigation@13"
        },
        {
          "when": "keith-diagram-focused",
          "command": "keith-vscode.diagram.restart",
          "group": "navigation@0"
        },
        {
          "when": "keith-diagram-focused && keith-vscode.syncWithEditor",
          "command": "keith-vscode.diagram.refresh",
          "group": "navigation@1"
        },
        {
          "when": "keith-diagram-focused && keith-vscode.syncWithEditor",
          "command": "keith-vscode.diagram.fit",
          "group": "navigation@2"
        },
        {
          "when": "keith-diagram-focused && !keith-vscode.syncWithEditor",
          "command": "keith-vscode.diagram.sync",
          "group": "2_diagram-controls@1"
        },
        {
          "when": "keith-diagram-focused && keith-vscode.syncWithEditor",
          "command": "keith-vscode.diagram.noSync",
          "group": "2_diagram-controls@1"
        },
        {
          "when": "keith-diagram-focused",
          "command": "keith-vscode.diagram.export",
          "group": "2_diagram-controls@2"
        },
        {
          "command": "keith-vscode.generate-code",
          "when": "resourceLangId == sctx && resourceScheme == file",
          "group": "navigation@3"
        },
        {
          "command": "keith-vscode.save-generated-code",
          "when": "resourceScheme == sccharts-generated",
          "group": "navigation@1"
        },
        {
          "command": "keith-vscode.save-all-generated-code",
          "when": "resourceScheme == sccharts-generated",
          "group": "navigation@2"
        },
        {
          "when": "keith-diagram-focused",
          "command": "keith-vscode.restart-language-server",
          "group": "9_restart"
        },
        {
          "when": "keith-diagram-focused",
          "command": "keith-vscode.show-stage",
          "group": "2_diagram-controls@3"
        }
      ],
      "editor/context": [
        {
          "when": "resourceLangId in keith-vscode.languages",
          "command": "keith-vscode.diagram.open",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "when": "resourceLangId in keith-vscode.languages",
          "command": "keith-vscode.diagram.open",
          "group": "navigation"
        },
        {
          "command": "keith-vscode.generate-code",
          "when": "resourceExtname == .sctx && resourceScheme == file",
          "group": "2_codegen"
        }
      ]
    },
    "configuration": {
      "title": "SCCharts Lab",
      "properties": {
        "keith-vscode.autocompile.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Specifies whether compilations shall happen on save."
        },
        "keith-vscode.compileInplace.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Specifies whether compilations shall happen in place."
        },
        "keith-vscode.showResultingModel.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Specifies whether the model of the compilation shall be shown after compilation."
        },
        "keith-vscode.showPrivateSystems.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Specifies whether private compilation systems shall be shown."
        },
        "keith-vscode.simulationStepDelay": {
          "type": "integer",
          "minimum": 0,
          "default": 200,
          "description": "Time in milliseconds to wait till next simulation step is requested in play mode."
        },
        "keith-vscode.simulationType": {
          "type": "string",
          "default": "Periodic",
          "description": "The currently selected simulation type.",
          "enum": [
            "Periodic",
            "Manual",
            "Dynamic"
          ]
        },
        "keith-vscode.showInternalVariables.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Specifies whether internal variables shall be shown in the simulation widget (e.g. guards, ...)."
        }
      }
    },
    "keybindings": [
      {
        "command": "keith-vscode.simulation-step",
        "key": "ctrl+alt+s",
        "when": "keith.vscode:simulationRunning"
      },
      {
        "command": "keith-vscode.simulation-run",
        "key": "ctrl+alt+r",
        "when": "keith.vscode:simulationRunning && !keith.vscode:play"
      },
      {
        "command": "keith-vscode.simulation-pause",
        "key": "ctrl+alt+r",
        "when": "keith.vscode:simulationRunning && keith.vscode:play"
      },
      {
        "command": "keith-vscode.simulation-stop",
        "key": "ctrl+alt+x",
        "when": "keith.vscode:simulationRunning"
      },
      {
        "command": "keith-vscode.diagram.restart",
        "key": "ctrl+alt+d",
        "when": "keith-diagram-focused || keith-vscode.diagramOpen"
      },
      {
        "command": "keith-vscode.diagram.open",
        "key": "ctrl+alt+v",
        "when": "resourceLangId in keith-vscode.languages"
      }
    ]
  },
  "scripts": {
    "clean": "rimraf dist pack",
    "lint": "eslint .",
    "lint-fix": "eslint --fix .",
    "test": "node --test test/*.test.cjs",
    "test:server": "npm run build:server && node test/server-smoke.cjs && node test/server-diagnostics.cjs && node test/server-codegen.cjs",
    "build": "node scripts/build-server-patch.cjs && webpack --mode production",
    "watch": "webpack --watch",
    "package": "vsce package --yarn -o sccharts-lab.vsix",
    "vscode:prepublish": "yarn run build",
    "build:server": "node scripts/build-server-patch.cjs --required",
    "fetch-server": "node scripts/fetch-server.cjs"
  },
  "devDependencies": {
    "@types/node": "^16.11.7",
    "@types/react": "^18.3.0",
    "@types/vscode": "^1.85.0",
    "@types/vscode-webview": "^1.57.4",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
